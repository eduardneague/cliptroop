# Copy this file to .env.local and fill in real values for local development.
# NEVER commit .env.local — it's already in .gitignore.
#
# Get these from: Supabase project → Settings → Data API
# Use your STAGING project's values for local development.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — used to send real team invites via Supabase Auth.
# Get it from: Supabase project → Settings → API Keys → "Secret" key.
# NEVER prefix this with NEXT_PUBLIC_ — it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional — your deployed URL (e.g. https://vplanner-eight.vercel.app),
# only used to generate sitemap.xml. Safe to leave blank locally.
NEXT_PUBLIC_SITE_URL=

# The app's own address (1.9.1). Production only, no slash at the end, e.g.
# https://app.yourdomain.com. Platform return addresses and email links use
# it, and production's old *.vercel.app address moves to it.
# NEXT_PUBLIC_APP_URL=
# Staging's own address (Preview only), e.g. https://staging.yourdomain.com.
# STAGING_URL=
# Every value for THIS copy: open /setup (Settings → Account → App setup).

# Emails the app sends itself (alerts, hand-offs, meetings) through Resend.
# RESEND_API_KEY=
# EMAIL_FROM=VPlanner <notifications@yourdomain.com>

# Connected accounts. SOCIAL_TOKEN_KEY locks the stored sign-ins: make it once
# (openssl rand -hex 32: 64 characters) and never change it.
# SOCIAL_TOKEN_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=

# Largest video an editor can upload, in MB. Must match Supabase:
# Storage → Settings → Global file size limit.
#   Staging (free plan): 50      Production (Pro): 2048
NEXT_PUBLIC_MAX_VIDEO_MB=50
# Long videos' edits (1.25.0), in MB, at most 3072 (the bucket's own limit).
# Unset = the same as shorts. Supabase's global limit must allow it too.
#   Production (Pro): 3072
# NEXT_PUBLIC_MAX_LONG_VIDEO_MB=3072

# Secret for scheduled jobs (daily video cleanup). Vercel sends it
# automatically to /api/cron/*. Generate: openssl rand -hex 32
CRON_SECRET=

# Analytics (1.4). Which connected platforms also ask for permission to read
# stats when someone connects/reconnects them. Comma list of youtube,
# instagram, tiktok. Default: youtube. Add instagram / tiktok only after
# turning the matching permission on in that platform's developer app
# (Instagram: instagram_business_manage_insights, TikTok: user.info.stats +
# video.list), or their sign-in will refuse to start.
SOCIAL_STATS_PLATFORMS=youtube
# Optional: Instagram Graph API version (default v23.0) and the currency
# label used for YouTube revenue (default USD).
# INSTAGRAM_GRAPH_VERSION=v23.0
# ANALYTICS_CURRENCY=USD

# Facebook Pages (analytics 1.6, posting Reels 1.12): the Meta app's own App
# ID and secret (App settings → Basic; NOT the Instagram app ID). Add the
# product "Facebook Login for Business" (or Facebook Login) with the
# permissions pages_show_list, pages_read_engagement, read_insights and
# pages_manage_posts (posting), and the return address from Team → Connected
# accounts → Setup check as a Valid OAuth Redirect URI. Optional: a Facebook
# Login for Business configuration ID (tick the same four permissions in it).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# FACEBOOK_LOGIN_CONFIG_ID=
# FACEBOOK_GRAPH_VERSION=v23.0

# Developer accounts (1.9.8; ALERT_EMAILS is the old name and still works).
# Comma list of the emails these people SIGN IN with. These accounts open
# /developer and /setup and are the ONLY ones who get the app-wide alerts
# (email + notification when something breaks). Blank: nobody in production
# (staging and your computer fall back to the owner of the first team).
# Alerts are sent from production only; ALERT_ON_PREVIEW=1 sends them from
# staging too. Everything is recorded on /developer either way.
# DEVELOPER_EMAILS=you@example.com
# ALERT_ON_PREVIEW=1

# The Supabase plan this project is on, for the developer's Usage page
# (limits: Free 500 MB database / 1 GB files; Pro 8 GB / 100 GB). Default: free.
# SUPABASE_PLAN=pro

# Push notifications (1.9). Make the pair in Settings → Notifications & app
# (shown to the team owner while they're missing). Same pair in every
# environment is fine. Redeploy after setting (the public one is built in).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Legal pages (1.9) and the website (1.33.0: Contact, Security, Pricing,
# the footers, /.well-known/security.txt): where people write (needed for
# the Google / Meta / TikTok approvals), and who runs the app (a company's
# registered name, or yours; empty = "the ClipTroop team").
# NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
# NEXT_PUBLIC_COMPANY_NAME=

# Writing suggestions in scripts (1.23.0). Nothing to set: by default each
# person's browser asks LanguageTool's free service (20 checks a minute per
# person). For a team that writes a lot, or to keep texts on your own server,
# set ONE of these and the app checks through /api/grammar instead (the keys
# never reach the browser):
#   your own LanguageTool server (e.g. the Docker image erikvl87/languagetool):
# LANGUAGETOOL_URL=https://languagetool.yourdomain.com
#   or a LanguageTool account (languagetool.org → Proofreading API):
# LANGUAGETOOL_USERNAME=you@example.com
# LANGUAGETOOL_API_KEY=

# Outliers (1.27.0): a YouTube Data API key, so Outliers reads YouTube's
# public videos with the app's own daily allowance. Google Cloud → APIs &
# Services → Credentials → Create API key, then Edit it → API restrictions →
# Restrict key → only "YouTube Data API v3" (1.31.0: every key restricted to
# the one API it's for).
# YOUTUBE_API_KEY=
# Optional shares of YouTube's daily allowance (modules/outliers/lib/budget.ts
# says what each one is): OUTLIERS_SEARCHES_PER_DAY (90),
# OUTLIERS_CRAWL_SEARCHES (45), OUTLIERS_PERSON_SEARCHES (15),
# OUTLIERS_TEAM_SEARCHES (40), OUTLIERS_DAILY_UNITS (4000),
# OUTLIERS_STATS_PER_DAY (5000), OUTLIERS_STATS_DAYS (30), OUTLIERS_EXPLORE
# (0 turns the Explore niches off), OUTLIERS_EXPLORE_UNITS (1200),
# OUTLIERS_EXPLORE_SEARCHES (6).
# OUTLIERS_DAILY_UNITS=4000

# GIFs in comments (developers.giphy.com → Create an API key). Only signed-in
# people can search with it (1.31.0), and it never reaches the browser.
# GIPHY_API_KEY=

# How often every video's counts are read (1.19.0): empty = every 10 minutes;
# 20, 30 or 60 for a lighter load (Vercel Hobby's monthly CPU).
# LIVE_MINUTES=

# Only on your computer: where the currency rates come from (the dev mock
# serves sample ones). Ignored on Vercel (staging and production).
# FX_RATES_URL=

# Only on your computer: where BNR's exchange rates come from for Business
# (1.42.0; the dev mock serves sample ones at http://127.0.0.1:54321/bnr/).
# Ignored on Vercel (staging and production): there it's always bnr.ro.
# BNR_RATES_URL=

# The pages' Content Security Policy (1.31.16, lib/csp.ts): leave it out.
# Only in an emergency (something the app needs got blocked): report-only
# (the browser's console says what it would block, nothing is blocked) or
# off; then redeploy and tell the developer.
# CSP_MODE=

# The "not a robot" check on Create an account (1.45.0, Cloudflare Turnstile):
# Cloudflare → Turnstile → Add site (your app's domain), then its two keys.
# The site key is public (the browser shows the check with it); the secret
# stays on the server, which asks Cloudflare whether the answer is right.
# Without them sign-ups still work, with no check (App setup says so).
# Leave Supabase's own Captcha protection off.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
