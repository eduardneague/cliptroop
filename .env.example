# Copy this file to .env.local and fill in real values for local development.
# NEVER commit .env.local — it's already in .gitignore.
#
# Get these from: Supabase project → Settings → Data API
# Use your STAGING project's values for local development.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — used to send real team invites via Supabase Auth.
# Get it from: Supabase project → Settings → API Keys → "Secret" key.
# NEVER prefix this with NEXT_PUBLIC_ — it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional — your deployed URL (e.g. https://vplanner-eight.vercel.app),
# only used to generate sitemap.xml. Safe to leave blank locally.
NEXT_PUBLIC_SITE_URL=

# The app's own address (1.9.1). Production only, no slash at the end, e.g.
# https://app.yourdomain.com. Platform return addresses and email links use
# it, and production's old *.vercel.app address moves to it.
# NEXT_PUBLIC_APP_URL=
# Staging's own address (Preview only), e.g. https://staging.yourdomain.com.
# STAGING_URL=
# Every value for THIS copy: open /setup (Settings → Account → App setup).

# Emails the app sends itself (alerts, hand-offs, meetings) through Resend.
# RESEND_API_KEY=
# EMAIL_FROM=VPlanner <notifications@yourdomain.com>

# Connected accounts. SOCIAL_TOKEN_KEY locks the stored sign-ins: make it once
# (openssl rand -hex 32: 64 characters) and never change it.
# SOCIAL_TOKEN_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=

# Largest video an editor can upload, in MB. Must match Supabase:
# Storage → Settings → Global file size limit.
#   Staging (free plan): 50      Production (Pro): 2048
NEXT_PUBLIC_MAX_VIDEO_MB=50

# Secret for scheduled jobs (daily video cleanup). Vercel sends it
# automatically to /api/cron/*. Generate: openssl rand -hex 32
CRON_SECRET=

# Analytics (1.4). Which connected platforms also ask for permission to read
# stats when someone connects/reconnects them. Comma list of youtube,
# instagram, tiktok. Default: youtube. Add instagram / tiktok only after
# turning the matching permission on in that platform's developer app
# (Instagram: instagram_business_manage_insights, TikTok: user.info.stats +
# video.list), or their sign-in will refuse to start.
SOCIAL_STATS_PLATFORMS=youtube
# Optional: Instagram Graph API version (default v23.0) and the currency
# label used for YouTube revenue (default USD).
# INSTAGRAM_GRAPH_VERSION=v23.0
# ANALYTICS_CURRENCY=USD

# Facebook Page analytics (1.6): the Meta app's own App ID and secret (App
# settings → Basic; NOT the Instagram app ID). Add the product "Facebook
# Login for Business" (or Facebook Login) with the permissions
# pages_show_list, pages_read_engagement and read_insights, and the return
# address from Team → Connected accounts → Setup check as a Valid OAuth
# Redirect URI. Optional: a Facebook Login for Business configuration ID.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# FACEBOOK_LOGIN_CONFIG_ID=
# FACEBOOK_GRAPH_VERSION=v23.0

# Error alerts (1.8). Who gets an email + notification when something breaks
# (comma list). Leave blank and the team owners get them. Alerts are sent
# from production only; ALERT_ON_PREVIEW=1 sends them from staging too.
# Everything is recorded on /status either way.
# ALERT_EMAILS=you@example.com
# ALERT_ON_PREVIEW=1

# Push notifications (1.9). Make the pair in Settings → Notifications & app
# (shown to the team owner while they're missing). Same pair in every
# environment is fine. Redeploy after setting (the public one is built in).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Legal pages (1.9): where people write about their data (needed for the
# Google / Meta / TikTok approvals), and the company name once there is one.
# NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
# NEXT_PUBLIC_COMPANY_NAME=
